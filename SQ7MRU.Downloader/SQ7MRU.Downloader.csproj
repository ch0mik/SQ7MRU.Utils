<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <ProjectReference Include="../SQ7MRU.Utils/SQ7MRU.Utils.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SQ7MRU.Utils.Core\SQ7MRU.Utils.Core.csproj" />
    <ProjectReference Include="..\SQ7MRU.Utils.Application\SQ7MRU.Utils.Application.csproj" />
  </ItemGroup>
  <Target Name="GenerateVersionedApplicationManifest" BeforeTargets="PrepareForBuild" DependsOnTargets="GetAssemblyVersion">
    <PropertyGroup>
      <ApplicationManifest>$(IntermediateOutputPath)app.manifest</ApplicationManifest>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/app.manifest" DestinationFiles="$(ApplicationManifest)" />
    <XmlPoke XmlInputPath="$(ApplicationManifest)"
             Query="/*[local-name()='assembly']/*[local-name()='assemblyIdentity']/@version"
             Value="$(AssemblyVersion)" />
  </Target>
  <Target Name="ExcludeDocumentationAndDebugSymbolsFromSingleFilePublish" AfterTargets="ComputeFilesToPublish"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.xml' And
                               ('%(ResolvedFileToPublish.Filename)' == 'SQ7MRU.Utils' Or
                                '%(ResolvedFileToPublish.Filename)' == 'SQ7MRU.Utils.Core' Or
                                '%(ResolvedFileToPublish.Filename)' == 'SQ7MRU.Utils.Application')" />
    </ItemGroup>
  </Target>
</Project>
