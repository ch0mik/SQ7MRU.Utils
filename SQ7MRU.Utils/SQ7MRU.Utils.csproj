<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SQ7MRU.Utils</PackageId>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Authors>Pawel Janowski SQ7MRU</Authors>
    <Description>Asynchronous ADIF, eQSL, HRDLog and EPC tools with dependency injection and cancellation.</Description>
    <PackageProjectUrl>https://github.com/ch0mik/SQ7MRU.Utils</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ch0mik/SQ7MRU.Utils</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <PackageTags>HamRadio;ADIF;eQSL;EPC;HRDLog</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeLayers</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ADIF/adif-metadata.json" />
    <ProjectReference Include="../SQ7MRU.Utils.Core/SQ7MRU.Utils.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="../SQ7MRU.Utils.Application/SQ7MRU.Utils.Application.csproj" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="IncludeLayers">
    <ItemGroup>
      <BuildOutputInPackage Include="$(TargetDir)SQ7MRU.Utils.Core.dll" />
      <BuildOutputInPackage Include="$(TargetDir)SQ7MRU.Utils.Application.dll" />
      <BuildOutputInPackage Include="$(TargetDir)SQ7MRU.Utils.Core.xml" />
      <BuildOutputInPackage Include="$(TargetDir)SQ7MRU.Utils.Application.xml" />
    </ItemGroup>
  </Target>
</Project>
